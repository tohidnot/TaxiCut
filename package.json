{
  "name": "taxicut",
  "version": "0.1.0",
  "description": "TaxiCut — MIT-licensed AI-agent-friendly desktop video editor",
  "main": "out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "tsx scripts/smoke-mcp.mts",
    "postinstall": "electron-rebuild -f -w node-pty || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "electron": "^33.4.11",
    "electron-vite": "^2.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@33.4.11": true,
    "node-pty@1.1.0": true,
    "@electron/rebuild@3.7.2": true
  }
}
